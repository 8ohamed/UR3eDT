<?xml version="1.0"?>
<robot name="ur3e_full">

  <link name="base_link">
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.004"/>
    </inertial>
  </link>

  <link name="shoulder_link">
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.008" ixy="0.0" ixz="0.0" iyy="0.008" iyz="0.0" izz="0.005"/>
    </inertial>
  </link>

  <link name="upper_arm_link">
    <inertial>
      <mass value="3.42"/>
      <origin xyz="0 0 0.1218" rpy="0 0 0"/>
      <inertia ixx="0.021" ixy="0.0" ixz="0.0" iyy="0.021" iyz="0.0" izz="0.009"/>
    </inertial>
  </link>

  <link name="forearm_link">
    <inertial>
      <mass value="1.437"/>
      <origin xyz="0 0 0.1065" rpy="0 0 0"/>
      <inertia ixx="0.006" ixy="0.0" ixz="0.0" iyy="0.006" iyz="0.0" izz="0.002"/>
    </inertial>
  </link>

  <link name="wrist_1_link">
    <inertial>
      <mass value="0.871"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <link name="wrist_2_link">
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <link name="wrist_3_link">
    <inertial>
      <mass value="0.35"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="payload">
    <inertial>
      <mass value="2.65"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <!-- Approx inertia for a compact 2.65 kg tool (radius ~4 cm) -->
      <inertia ixx="0.0021" ixy="0" ixz="0"
             iyy="0.0021" iyz="0"
             izz="0.0021"/>
    </inertial>
  </link>

  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.15185" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="54.0" lower="-6.28" upper="6.28" velocity="3.14"/>
  </joint>

  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0.12 0" rpy="0 1.5707 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="54.0" lower="-6.28" upper="6.28" velocity="3.14"/>
  </joint>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 -0.093 0.24365" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="28.0" lower="-3.14" upper="3.14" velocity="3.14"/>
  </joint>

  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="0 0 0.2132" rpy="0 1.5707 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="9.0" lower="-6.28" upper="6.28" velocity="6.28"/>
  </joint>

  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 0.08535 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="9.0" lower="-6.28" upper="6.28" velocity="6.28"/>
  </joint>

  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin xyz="0 0 0.0819" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="9.0" lower="-6.28" upper="6.28" velocity="6.28"/>
  </joint>

  <joint name="payload_fixed_joint" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="payload"/>
    <origin xyz="0 0 0.0819" rpy="0 0 0"/>
  </joint>

</robot>